---
import Background3D from "../components/Background3D.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "cihadtekinbas", description = "Personal site of cihadtekinbas" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Background3D />
    <header class="site">
      <nav class="container">
        <a class="brand" href="/">cihadtekinbas</a>
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site">
      <div class="container">© {new Date().getFullYear()} cihadtekinbas</div>
    </footer>
  </body>
</html>
