# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env — it contains secrets.

# Port the Express server listens on (hosts usually set this).
PORT=3000

# Public URL of the app. MUST match the OAuth "Authorization callback URL"
# (callback is {BASE_URL}/auth/callback). In local dev: http://localhost:3000
# In production: https://<your-app>.onrender.com (no trailing slash).
BASE_URL=http://localhost:3000

# Set to "production" to enable secure cookie flags (required on HTTPS hosts).
NODE_ENV=development

# From your GitHub OAuth App:
#   github.com -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Long random string used to sign session cookies.
# Generate one, e.g. openssl rand -hex 32
SESSION_SECRET=generate_a_long_random_string

# Only GitHub logins matching this are allowed through.
ALLOWED_USERNAME=cihadtekinbas
